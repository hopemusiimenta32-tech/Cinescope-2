# Server-only settings. Copy this file to server/.env.
# TMDB_READ_ACCESS_TOKEN is private and must never be placed in client/.env or a VITE_ variable.
TMDB_READ_ACCESS_TOKEN=replace_with_your_tmdb_read_access_token
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Public client setting. If needed, put only this value in client/.env.
# VITE_ variables are included in browser code; use this only for the public backend URL.
VITE_API_BASE_URL=http://localhost:5000/api
